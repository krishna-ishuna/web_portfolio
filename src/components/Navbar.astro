---
interface Props {
    nama: string;
}

const { nama } = Astro.props;
---

<header
    class="sticky top-0 z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800 transition-colors duration-300"
>
    <div
        class="max-w-5xl mx-auto px-6 py-4 flex justify-between items-center relative z-20"
    >
        <!-- Logo / Gambar -->
        <a href="#" class="flex items-center">
            <img
                src="/logo.png"
                alt={nama}
                class="w-9 h-9 rounded-full object-cover border border-slate-200 dark:border-slate-700 shadow-sm"
            />
        </a>

        <!-- Navigasi Desktop -->
        <nav
            class="hidden md:flex space-x-8 text-sm font-medium text-slate-600 dark:text-slate-300"
        >
            <a
                href="#tentang"
                class="hover:text-blue-600 dark:hover:text-blue-400 transition"
                >Tentang</a
            >
            <a
                href="#pendidikan"
                class="hover:text-blue-600 dark:hover:text-blue-400 transition"
                >Pendidikan</a
            >
            <a
                href="#keahlian"
                class="hover:text-blue-600 dark:hover:text-blue-400 transition"
                >Keahlian</a
            >
            <a
                href="#sertifikat"
                class="hover:text-blue-600 dark:hover:text-blue-400 transition"
                >Sertifikat</a
            >
            <a
                href="#documentation"
                class="hover:text-blue-600 dark:hover:text-blue-400 transition"
                >Dokumentasi</a
            >
        </nav>

        <div class="flex items-center gap-3">
            <!-- Tombol Dark Mode Toggle -->
            <button
                id="theme-toggle"
                type="button"
                aria-label="Toggle Theme"
                class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition cursor-pointer"
            >
                <svg
                    id="theme-toggle-dark-icon"
                    class="w-5 h-5 hidden"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
                    ></path>
                </svg>
                <svg
                    id="theme-toggle-light-icon"
                    class="w-5 h-5 hidden"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z"
                        fill-rule="evenodd"
                        clip-rule="evenodd"></path>
                </svg>
            </button>

            <!-- Tombol Kontak (Desktop) -->
            <a
                href="mailto:krishnaradityaariela@gmail.com"
                class="hidden sm:inline-flex bg-blue-600 hover:bg-blue-700 text-white text-sm px-4 py-2 rounded-full font-medium transition"
            >
                Kontak
            </a>

            <!-- Tombol Hamburger Menu (Mobile Only) -->
            <button
                id="mobile-menu-btn"
                type="button"
                aria-label="Toggle Mobile Menu"
                class="md:hidden p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition cursor-pointer"
            >
                <svg
                    id="hamburger-icon"
                    class="w-6 h-6 transition-transform duration-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
                <svg
                    id="close-icon"
                    class="w-6 h-6 hidden transition-transform duration-300 rotate-90"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Dropdown Menu Mobile -->
    <div
        id="mobile-menu"
        class="md:hidden absolute top-full left-0 w-full bg-white/95 dark:bg-slate-900/95 backdrop-blur-md shadow-lg overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0 -translate-y-2 border-b-0 border-slate-200 dark:border-slate-800 z-10"
    >
        <!-- Navigasi Mobile -->
        <div class="px-6 py-4 space-y-3">
            <a
                href="#tentang"
                class="mobile-nav-link block text-sm font-medium text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 py-1 transition"
                >Tentang</a
            >
            <a
                href="#pendidikan"
                class="mobile-nav-link block text-sm font-medium text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 py-1 transition"
                >Pendidikan</a
            >
            <a
                href="#keahlian"
                class="mobile-nav-link block text-sm font-medium text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 py-1 transition"
                >Keahlian</a
            >
            <a
                href="#sertifikat"
                class="mobile-nav-link block text-sm font-medium text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 py-1 transition"
                >Sertifikat</a
            >
            <a
                href="#documentation"
                class="mobile-nav-link block text-sm font-medium text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 py-1 transition"
                >Dokumentasi</a
            >
        </div>
    </div>
</header>

<script is:inline>
    const setupNavbar = () => {
        const themeToggleBtn = document.getElementById("theme-toggle");
        const darkIcon = document.getElementById("theme-toggle-dark-icon");
        const lightIcon = document.getElementById("theme-toggle-light-icon");

        const isDark =
            localStorage.getItem("color-theme") === "dark" ||
            (!("color-theme" in localStorage) &&
                window.matchMedia("(prefers-color-scheme: dark)").matches);

        if (isDark) {
            document.documentElement.classList.add("dark");
            lightIcon?.classList.remove("hidden");
            darkIcon?.classList.add("hidden");
        } else {
            document.documentElement.classList.remove("dark");
            darkIcon?.classList.remove("hidden");
            lightIcon?.classList.add("hidden");
        }

        // --- Event Listener Tombol Dark Mode Toggle ---
        themeToggleBtn?.addEventListener("click", () => {
            const isDarkModeNow =
                document.documentElement.classList.toggle("dark");

            if (isDarkModeNow) {
                localStorage.setItem("color-theme", "dark");
                lightIcon?.classList.remove("hidden");
                darkIcon?.classList.add("hidden");
            } else {
                localStorage.setItem("color-theme", "light");
                darkIcon?.classList.remove("hidden");
                lightIcon?.classList.add("hidden");
            }

            // Kirim custom event ke MusicPlayer agar audio memutar secara otomatis
            window.dispatchEvent(new CustomEvent("theme-toggle-clicked"));
        });

        // --- Logic Hamburger Menu Mobile ---
        const menuBtn = document.getElementById("mobile-menu-btn");
        const mobileMenu = document.getElementById("mobile-menu");
        const hamburgerIcon = document.getElementById("hamburger-icon");
        const closeIcon = document.getElementById("close-icon");
        const mobileLinks = document.querySelectorAll(".mobile-nav-link");

        let isMenuOpen = false;

        const toggleMenu = (forceClose = false) => {
            if (forceClose && !isMenuOpen) return;
            isMenuOpen = forceClose ? false : !isMenuOpen;

            if (isMenuOpen) {
                mobileMenu.classList.remove(
                    "max-h-0",
                    "opacity-0",
                    "-translate-y-2",
                );
                mobileMenu.classList.add(
                    "max-h-96",
                    "opacity-100",
                    "translate-y-0",
                    "border-b",
                );
                hamburgerIcon.classList.add("hidden", "-rotate-90");
                closeIcon.classList.remove("hidden", "rotate-90");
                closeIcon.classList.add("rotate-0");
            } else {
                mobileMenu.classList.remove(
                    "max-h-96",
                    "opacity-100",
                    "translate-y-0",
                    "border-b",
                );
                mobileMenu.classList.add(
                    "max-h-0",
                    "opacity-0",
                    "-translate-y-2",
                );
                closeIcon.classList.add("hidden", "rotate-90");
                hamburgerIcon.classList.remove("hidden", "-rotate-90");
                hamburgerIcon.classList.add("rotate-0");
            }
        };

        menuBtn?.addEventListener("click", () => toggleMenu());
        mobileLinks.forEach((link) => {
            link.addEventListener("click", () => toggleMenu(true));
        });
        window.addEventListener(
            "scroll",
            () => {
                if (isMenuOpen) toggleMenu(true);
            },
            { passive: true },
        );
    };

    setupNavbar();
    document.addEventListener("astro:after-swap", setupNavbar);
</script>
