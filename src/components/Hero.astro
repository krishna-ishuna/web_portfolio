---
interface Props {
    nama: string;
    peran: string;
    tentang: string;
}

const { nama, peran, tentang } = Astro.props;
---

<section id="tentang" class="pt-8 md:pt-16 max-w-3xl space-y-6">
    <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-800 text-blue-700 dark:text-blue-300 text-xs font-semibold"
    >
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Terbuka untuk Peluang Kerjasama
    </div>

    <div>
        <h1
            class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight"
        >
            Halo, Saya <span
                class="bg-gradient-to-r from-blue-600 via-blue-700 to-blue-600 bg-clip-text text-transparent"
                >{nama}</span
            >
        </h1>
        <p
            class="text-lg sm:text-xl text-blue-600 dark:text-blue-400 font-semibold mt-2"
        >
            {peran}
        </p>
    </div>

    <p
        class="text-slate-600 dark:text-slate-300 leading-relaxed text-base sm:text-lg"
    >
        {tentang}
    </p>

    <div class="flex flex-wrap gap-4 pt-2">
        <a
            href="#documentation"
            class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm rounded-xl shadow-md hover:shadow-blue-500/20 active:scale-95 transition-all duration-200"
        >
            Lihat Dokumentasi
        </a>
        <a
            href="mailto:krishnaradityaariela@gmail.com"
            class="px-6 py-3 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 font-medium text-sm rounded-xl active:scale-95 transition-all duration-200"
        >
            Hubungi Saya
        </a>
    </div>
</section>
