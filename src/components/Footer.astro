---
interface Props {
    nama: string;
}

const { nama } = Astro.props;
---

<!-- Floating Sticky Footer -->
<footer
    class="fixed bottom-0 left-0 w-full z-40 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-t border-slate-200/80 dark:border-slate-800 py-3 transition-colors duration-300"
>
    <div
        class="max-w-5xl mx-auto px-6 flex items-center justify-between text-xs font-medium text-slate-600 dark:text-slate-400"
    >
        <!-- Hak Cipta Singkat -->
        <p class="truncate pr-2">
            © {new Date().getFullYear()}
            <span class="text-slate-900 dark:text-white font-semibold"
                >{nama}</span
            >
        </p>

        <!-- Tautan Sosial & Tombol Ke Atas -->
        <div class="flex items-center gap-3 shrink-0">
            <a
                href="https://github.com/krishna-ishuna"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
                GitHub
            </a>
            <span class="text-slate-300 dark:text-slate-700">•</span>
            <a
                href="https://www.linkedin.com/in/krishna-raditya-ariela-31a420421?utm_source=share_via&utm_content=profile&utm_medium=member_android"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
                LinkedIn
            </a>

            <!-- Tombol Ke Atas Ringkas -->
            <button
                id="back-to-top"
                type="button"
                aria-label="Kembali ke atas"
                class="ml-2 p-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-lg transition-all active:scale-95 cursor-pointer"
            >
                <svg
                    class="w-3.5 h-3.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
                </svg>
            </button>
        </div>
    </div>
</footer>

<!-- Spacer Tambahan di Main Page agar Konten Terbawah Tidak Tertutup Footer -->
<script is:inline>
    const setupFooter = () => {
        const backToTopBtn = document.getElementById("back-to-top");
        backToTopBtn?.addEventListener("click", () => {
            window.scrollTo({
                top: 0,
                behavior: "smooth",
            });
        });
    };

    setupFooter();
    document.addEventListener("astro:after-swap", setupFooter);
</script>
